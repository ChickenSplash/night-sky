#!/usr/bin/env python3
"""Thin, loopback-only client for the Night Sky developer API."""
import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


def port(value):
    try:
        number = int(value)
        if 1 <= number <= 65535:
            return number
    except ValueError:
        pass
    raise argparse.ArgumentTypeError("port must be 1..65535")


def interval(value):
    import math
    try:
        number = float(value)
        if math.isfinite(number) and number >= 0.1:
            return number
    except ValueError:
        pass
    raise argparse.ArgumentTypeError("interval must be finite and at least 0.1 seconds")


def parser():
    result = argparse.ArgumentParser(
        description="Night Sky developer CLI. Start the app with ./scripts/run.sh first.",
        epilog="Commands are checked against the app's state and refused with a reason (exit 1) if they "
        "would do nothing. Flights continue after acceptance: add --wait. Discover app commands with "
        "'ns commands' and list IDs with 'ns lists'.",
    )
    result.add_argument("--port", type=port, default=os.environ.get("NIGHT_SKY_API_PORT", "4322"))
    result.add_argument("--json", action="store_true", help="compact JSON, including command help")
    sub = result.add_subparsers(dest="action", required=True)
    sub.add_parser("help", help="show CLI usage without connecting")
    sub.add_parser("health", help="check the API listener")
    commands = sub.add_parser("commands", help="discover app command syntax and descriptions")
    commands.add_argument("name", nargs="?", help="one command, e.g. set_debug")
    for name in ("state", "perf"):
        read = sub.add_parser(name, help=f"read {name}, optionally a nested path")
        read.add_argument("path", nargs="?", default="", help="e.g. latest/split/preparation_ms")
        read.add_argument("--history", action="store_true", help="include history on the root endpoint")
        read.add_argument("--seconds", type=float, help="limit a history path to the last (0, 10] seconds")
    keys = sub.add_parser("keys", help="list child keys or array indices, without values")
    keys.add_argument("path", help="state, state/camera, perf/latest, etc.")
    cmd = sub.add_parser("cmd", help="run an app command (typed text or JSON)")
    cmd.add_argument("command", help='one quoted string, e.g. "set_debug bloom false"')
    cmd.add_argument("--wait", action="store_true", help="wait until any camera flight has landed")
    cmd.add_argument("--timeout", type=interval, default=30.0, help="seconds --wait may take (default 30)")
    sub.add_parser("lists", help="list IDs, names, task counts and system stars")
    shot = sub.add_parser("screenshot", help="save a screenshot and bug report, printing the PNG path")
    shot.add_argument("--no-wait", action="store_true", help="return before the PNG is written")
    inspect = sub.add_parser("inspect", help="read the active top-left inspector, including facts and actions")
    inspect.add_argument("path", nargs="?", default="", help="facts, actions, title, object, or any nested path")
    search = sub.add_parser(
        "search", help="search for objects and print the results (see 'ns catalogue')",
        description="Searches run in the app, from the camera unless --home or --origin is given. "
        "Words without = are an exact designation or ID. Ctrl+C or --timeout cancels the search.",
        epilog="example: ns search kind=planet planet_class=sub_neptune orbits.star_class=m within_ly=50")
    search.add_argument("query", nargs="+", help="query words, e.g. kind=star star_class=white_dwarf limit=5")
    search.add_argument("--home", action="store_true", help="search from home instead of the camera")
    search.add_argument("--origin", help="search from x,y,z parsecs from the galactic centre")
    search.add_argument("--work-cap", type=float, help="work cap in millions of units (default: the app's)")
    search.add_argument("--show", action="store_true",
                        help="send it to the in-game object browser (from the camera), then print its results")
    search.add_argument("--no-wait", action="store_true", help="print the request ID and return at once")
    search.add_argument("--timeout", type=interval, default=120.0, help="seconds to wait (default 120)")
    sub.add_parser("searches", help="list the searches the app keeps, newest first, without results")
    sub.add_parser("catalogue", help="what a search can name: kinds, families, properties and relationships")
    ship = sub.add_parser("ship", help="spawn, read, steer and remove ships (craft)")
    ships = ship.add_subparsers(dest="ship", required=True)
    spawn = ships.add_parser(
        "spawn", help="place a ship above a body, by default in a circular orbit",
        description="The body is a planet, star or barycentre ID, or a system's key; without --body, "
        "the selected planet or star, else the visited system. Its system must be loaded. Speeds and "
        "velocities are relative to the body, in km/s; a speed is prograde.",
        epilog="example: ns ship spawn --body 'g1.2.3/2' --altitude 400")
    spawn.add_argument("--body", help="body ID (default: the selection, else the visited system)")
    spawn.add_argument("--altitude", type=float, required=True, help="km above the surface")
    spawn.add_argument("--speed", type=float, help="prograde speed in km/s instead of circular")
    spawn.add_argument("--velocity", help="x,y,z km/s in the system's axes instead of circular")
    state = ships.add_parser("state", help="position, velocity, the body it is around, altitude and input")
    state.add_argument("id", nargs="?", help="one craft (default: all)")
    thrust = ships.add_parser("thrust", help="hold thrust as x,y,z m/s² in the system's axes (0,0,0 stops)")
    thrust.add_argument("vector", help="x,y,z, e.g. 0,0,1")
    thrust.add_argument("--id", help="craft ID (default: the selected or only craft)")
    follow = ships.add_parser("follow", help="fly to a craft and follow it")
    follow.add_argument("id")
    despawn = ships.add_parser("despawn", help="remove a craft, or all of them")
    despawn.add_argument("id", nargs="?", help="one craft (default: all)")
    watch = sub.add_parser("watch", help="repeatedly read state or perf, Ctrl+C stops")
    watch.add_argument("target", choices=("state", "perf"))
    watch.add_argument("path", nargs="?", default="", help="optional nested path")
    watch.add_argument("--interval", type=interval, default=0.5, help="seconds between reads (default 0.5)")
    return result


def endpoint(target, path="", query=None):
    # Preserve JSON-pointer ~0/~1 escapes, encode URL-special characters.
    suffix = "/" + urllib.parse.quote(path, safe="/~") if path else ""
    return "/" + target + suffix + ("?" + urllib.parse.urlencode(query) if query else "")


def request(api_port, path, body=None):
    headers = {}
    if body is not None:
        headers = {"X-Night-Sky-Client": "cli", "Content-Type": "text/plain; charset=utf-8"}
    url = f"http://127.0.0.1:{api_port}{path}"
    req = urllib.request.Request(url, data=body, headers=headers)
    # Local requests must not leave the machine through configured proxies.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(req, timeout=5) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        try:
            message = json.load(error).get("error", error.reason)
        except (ValueError, AttributeError):
            message = error.reason
        raise RuntimeError(f"HTTP {error.code}: {message}") from error
    except (urllib.error.URLError, TimeoutError) as error:
        raise RuntimeError(
            f"Cannot reach Night Sky on port {api_port}: {error}. "
            "Start ./scripts/run.sh with the API enabled."
        ) from error
    except ValueError as error:
        raise RuntimeError("API returned invalid JSON") from error


def output(value, compact=False, commands=False):
    if commands and not compact:
        for entry in value if isinstance(value, list) else [value]:
            print(f"{entry['synopsis']}\n  {entry['about']}")
    else:
        print(json.dumps(value, indent=None if compact else 2, ensure_ascii=False), flush=True)


def settle(api_port, after_ms, timeout):
    """Waits for a snapshot sampled after `after_ms` in which the camera is not
    flying. Snapshots publish at most every 250 ms."""
    deadline = time.monotonic() + timeout
    while True:
        state = request(api_port, endpoint("state"))
        if state.get("sampled_unix_ms", 0) > after_ms and not state["camera"]["flying"]:
            return {"trail": state["trail"], "presentation_mode": state["presentation_mode"],
                    "location_planet": state["location_planet"], "camera": state["camera"]}
        if time.monotonic() > deadline:
            raise RuntimeError(f"Camera still flying after {timeout:g} s")
        time.sleep(0.1)


def wait_for_file(path, timeout=5.0):
    deadline = time.monotonic() + timeout
    while not os.path.exists(path):
        if time.monotonic() > deadline:
            raise RuntimeError(f"Screenshot not written within {timeout:g} s: {path}")
        time.sleep(0.05)


def origin_value(args):
    if args.home and args.origin:
        raise RuntimeError("give --home or --origin, not both")
    if args.home:
        return "home"
    if args.origin:
        try:
            values = [float(part) for part in args.origin.split(",")]
        except ValueError:
            values = []
        if len(values) != 3:
            raise RuntimeError("--origin is x,y,z in parsecs, e.g. 8200,0,20")
        return values
    return "camera"


def wait_search(api_port, search_id, timeout):
    """Polls a search until it stops running; cancels it on timeout or Ctrl+C."""
    deadline = time.monotonic() + timeout
    shown = time.monotonic()
    try:
        while True:
            entry = request(api_port, f"/search/{search_id}")
            progress = entry["progress"]
            if entry.get("error") or progress["state"] != "running":
                return entry
            if time.monotonic() > deadline:
                request(api_port, f"/search/{search_id}/cancel", b"")
                raise RuntimeError(f"search #{search_id} still running after {timeout:g} s; cancelled")
            if sys.stderr.isatty() and time.monotonic() - shown > 1:
                shown = time.monotonic()
                print(f"\r#{search_id} searched out to {progress['complete_to_ly']:.1f} ly, "
                      f"{progress['stars'] / 1e6:.1f} M stars tried, {entry['result_count']} results  ",
                      end="", file=sys.stderr, flush=True)
            time.sleep(0.2)
    except KeyboardInterrupt:
        request(api_port, f"/search/{search_id}/cancel", b"")
        print(f"\nns: search #{search_id} cancelled", file=sys.stderr)
        raise
    finally:
        if sys.stderr.isatty():
            print("\r\033[K", end="", file=sys.stderr, flush=True)


def search_text(entry):
    progress = entry["progress"]
    origin = ", ".join(f"{x:.1f}" for x in entry["origin_pc"])
    lines = [f"#{entry['id']} {progress['state']} · {entry['result_count']} results · "
             f"{progress['elapsed_ms'] / 1000:.2f} s · from {origin} pc",
             f"  {entry['query']}"]
    if progress["state"] == "capped":
        lines.append(f"  work cap reached: searched out to {progress['complete_to_ly']:.1f} ly, "
                     "results nearer than that are exact")
    rows = [(f"{r['distance_ly']:.2f} ly", r["kind"], r["name"], r["class"], r["system"])
            for r in entry.get("results") or []]
    if rows:
        header = ("distance", "kind", "name", "class", "system")
        widths = [max(len(row[i]) for row in rows + [header]) for i in range(4)]
        for row in [header] + rows:
            lines.append("  " + "  ".join(cell.ljust(w) for cell, w in zip(row, widths)) + "  " + row[4])
    return "\n".join(lines)


def run_search(args):
    text = " ".join(args.query)
    if args.show:
        if args.home or args.origin or args.work_cap is not None:
            raise RuntimeError("--show searches from the camera with the app's work cap")
        before = max((entry["id"] for entry in request(args.port, "/search")), default=0)
        request(args.port, "/command", ("search " + text).encode("utf-8"))
        deadline = time.monotonic() + 5
        while True:
            shown = [e for e in request(args.port, "/search") if e["asker"] == "game" and e["id"] > before]
            if shown:
                search_id = shown[-1]["id"]
                break
            if time.monotonic() > deadline:
                raise RuntimeError("the app accepted the search but has not started it")
            time.sleep(0.1)
    else:
        body = {"query": text, "origin": origin_value(args)}
        if args.work_cap is not None:
            if args.work_cap <= 0:
                raise RuntimeError("--work-cap must be above 0")
            body["work_cap"] = int(args.work_cap * 1e6)
        reply = request(args.port, "/search", json.dumps(body).encode("utf-8"))
        search_id = reply["id"]
        if args.no_wait:
            return reply
    if args.no_wait:
        return {"id": search_id, "status": "running"}
    entry = wait_search(args.port, search_id, args.timeout)
    if entry.get("error"):
        raise RuntimeError(f"search #{search_id} refused: {entry['error']}")
    return entry


def catalogue_text(catalogue):
    lines = ["kinds (kind=)"]
    for kind in catalogue["kinds"]:
        lines.append(f"  {kind['id']:<14} {kind['label']} · family {kind['family']}")
    lines.append("families (family=)")
    for family in catalogue["families"]:
        lines.append(f"  {family['id']:<14} {family['label']}")
    lines.append("properties")
    for prop in catalogue["properties"]:
        values = prop["values"]
        if values["type"] == "choice":
            shape = ",".join(option[0] for option in values["options"])
        elif values["type"] == "flag":
            shape = "yes|no"
        else:
            shape = "min..max" + (f" {prop['unit']}" if prop.get("unit") else "")
        lines.append(f"  {prop['id']:<17} {prop['label']} · {shape} · for {', '.join(prop['kinds'])}")
    lines.append("relationships (prefix.property=)")
    for relation in catalogue["relations"]:
        lines.append(f"  {relation['id'] + '.':<17} {relation['label']} · "
                     f"{', '.join(relation['subjects'])} -> {', '.join(relation['targets'])}")
    lines.append("syntax")
    lines.extend(f"  {line}" for line in catalogue["syntax"])
    return "\n".join(lines)


def searches_text(entries):
    return "\n".join(
        f"#{e['id']:<4} {e['asker']:<4} {('refused' if e.get('error') else e['progress']['state']):<9} "
        f"{e['result_count']:>4} results {e['progress']['elapsed_ms'] / 1000:>7.2f} s  {e['query']}"
        for e in entries) or "no searches yet"


def vector(text, name):
    try:
        values = [float(part) for part in text.split(",")]
    except ValueError:
        values = []
    if len(values) != 3:
        raise RuntimeError(f"{name} is x,y,z, e.g. 0,7.5,0")
    return values


def ship_command(args):
    """The app command for a ship action, or None for a read."""
    if args.ship == "spawn":
        command = {"type": "spawn_ship", "altitude_km": args.altitude}
        if args.body:
            command["body"] = args.body
        if args.speed is not None and args.velocity:
            raise RuntimeError("give --speed or --velocity, not both")
        if args.speed is not None:
            command["speed_kms"] = args.speed
        if args.velocity:
            command["velocity_kms"] = vector(args.velocity, "--velocity")
        return command
    if args.ship == "thrust":
        command = {"type": "set_thrust", "thrust": vector(args.vector, "thrust")}
        if args.id:
            command["id"] = args.id
        return command
    if args.ship == "follow":
        return {"type": "fly_to_craft", "id": args.id}
    if args.ship == "despawn":
        return {"type": "despawn_craft", "id": args.id}
    return None


def ship(args):
    command = ship_command(args)
    if command is None:
        craft = request(args.port, endpoint("state", "craft"))
        if args.id:
            found = [entry for entry in craft["craft"] if entry["id"] == args.id]
            if not found:
                raise RuntimeError(f"no craft `{args.id}`")
            return found[0]
        return craft
    sent = time.time() * 1000
    result = request(args.port, "/command", json.dumps(command).encode("utf-8"))
    if args.ship == "spawn" and result.get("status") == "accepted":
        # The new ship is selected: report it from the first later snapshot.
        deadline = time.monotonic() + 2
        while time.monotonic() < deadline:
            state = request(args.port, endpoint("state"))
            selection = state.get("selection") or {}
            if state.get("sampled_unix_ms", 0) > sent and selection.get("kind") == "craft":
                found = [entry for entry in state["craft"]["craft"] if entry["id"] == selection["id"]]
                return dict(result, craft=found[0]) if found else result
            time.sleep(0.1)
    return result


def lists(state):
    return [{"id": entry["id"], "name": entry["name"], "tasks": entry["tasks"],
             "systems": [system["star"] for system in entry["systems"]]} for entry in state]


def main(argv=None):
    cli = parser()
    args = cli.parse_args(argv)
    if args.action == "help":
        cli.print_help()
        return 0
    try:
        if args.action == "commands":
            path = endpoint("commands", args.name or "")
        elif args.action == "inspect":
            path = endpoint("state", "inspector" + ("/" + args.path if args.path else ""))
        elif args.action in ("state", "perf"):
            query = {}
            if args.history:
                query["history"] = 1
            if args.seconds is not None:
                query["seconds"] = args.seconds
            path = endpoint(args.action, args.path, query)
        elif args.action == "keys":
            target, _, nested = args.path.partition("/")
            if target not in ("state", "perf"):
                cli.error("keys path must start with state or perf")
            path = endpoint(target, nested, {"keys": 1})
        elif args.action == "search":
            entry = run_search(args)
            print(json.dumps(entry, separators=(",", ":"), ensure_ascii=False) if args.json
                  else search_text(entry) if "progress" in entry
                  else json.dumps(entry, indent=2), flush=True)
            return 0
        elif args.action in ("searches", "catalogue"):
            value = request(args.port, "/search" if args.action == "searches" else "/catalogue")
            if args.json:
                output(value, True)
            else:
                print(searches_text(value) if args.action == "searches" else catalogue_text(value), flush=True)
            return 0
        elif args.action == "ship":
            output(ship(args), args.json)
            return 0
        elif args.action == "lists":
            output(lists(request(args.port, endpoint("state", "lists"))), args.json)
            return 0
        elif args.action == "watch":
            path = endpoint(args.target, args.path)
            while True:
                output(request(args.port, path), args.json)
                time.sleep(args.interval)
        else:
            path = endpoint("command" if args.action == "cmd" else args.action)
        body = args.command.encode("utf-8") if args.action == "cmd" else b"" if args.action == "screenshot" else None
        result = request(args.port, path, body)
        if args.action == "cmd" and args.wait and result.get("status") == "accepted":
            result["settled"] = settle(args.port, time.time() * 1000, args.timeout)
        if args.action == "screenshot" and result.get("png") and not args.no_wait:
            wait_for_file(result["png"])
            result["status"] = "saved"
        output(result, args.json, args.action == "commands")
        return 0
    except RuntimeError as error:
        print(f"ns: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 0
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
